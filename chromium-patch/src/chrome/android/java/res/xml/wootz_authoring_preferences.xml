<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <org.chromium.components.browser_ui.settings.TextMessagePreference
        android:key="wootz_authoring_description"
        android:summary="@string/wootz_authoring_description"
        app:allowDividerBelow="false" />

    <Preference
        android:key="wootz_authoring_current_tab_url"
        android:title="@string/wootz_authoring_current_tab_url_title"
        android:summary="@string/wootz_authoring_current_tab_url_empty" />

    <Preference
        android:key="wootz_authoring_start"
        android:title="@string/wootz_authoring_start_title"
        android:summary="@string/wootz_authoring_start_summary" />

    <Preference
        android:key="wootz_authoring_replay"
        android:title="@string/wootz_authoring_replay_title"
        android:summary="@string/wootz_authoring_replay_summary" />
</PreferenceScreen>
