#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -eq 0 ]; then
  set -- serve
fi

case "$1" in
  serve)
    exec /opt/chromium-runtime/serve.sh
    ;;
  status)
    shift
    exec python3 /opt/chromium-runtime/status.py "$@"
    ;;
  wait)
    shift
    exec python3 /opt/chromium-runtime/wait.py "$@"
    ;;
  version)
    exec "${CHROMIUM_BIN:-/opt/wootzapp/chrome}" --version
    ;;
  *)
    exec "$@"
    ;;
esac
