# Copy this file outside the image build context or pass it with docker compose --env-file.
# Do not commit real API keys.

# Used by agent-browser task mode when running with the OpenAI SDK.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Browser CDP target inside the desktop-browser container.
# Use a local debugging port such as 9222, or a full ws/wss CDP URL.
AGENT_BROWSER_CDP_TARGET=9222
AGENT_BROWSER_MAX_STEPS=20

# Optional alternative for official agent-browser chat mode.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=anthropic/claude-sonnet-4.6
AI_GATEWAY_URL=https://ai-gateway.vercel.sh
