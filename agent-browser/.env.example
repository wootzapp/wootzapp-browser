# Copy to .env.agent-browser and fill in runtime credentials.
# Do not commit real API keys.

OPENAI_API_KEY=
OPENAI_MODEL=

# CDP endpoint for the already-running Wootzapp Desktop Browser.
AGENT_BROWSER_CDP_TARGET=http://127.0.0.1:9222

# Required for OpenAI task mode. Set this from the calling harness.
AGENT_BROWSER_MAX_STEPS=

# Optional alternative gateway mode.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
AI_GATEWAY_URL=
